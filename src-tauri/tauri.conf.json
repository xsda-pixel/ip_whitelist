{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IpWhitelist",
  "version": "2.1.8",
  "identifier": "com.john.ipwhitelist",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IP白名单",
        "width": 1200,
        "height": 750
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://* ws://*;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
